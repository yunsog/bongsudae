      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (router) (increase(bongsudae_router_errors_total{instance=~\"$instance\",router=~\"$router\"}[5m])) > 0",
          "legendFormat": "parse error {{router}}",
          "refId": "A"
        },
        {
